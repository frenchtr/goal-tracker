{
  "name": "goal-tracker",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "test": "npm run test -w @goal-tracker/rules",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @goal-tracker/pc",
    "dev:pc": "npm run dev -w @goal-tracker/pc",
    "dev:phone": "npm run start -w @goal-tracker/phone",
    "build:pc": "npm run build -w @goal-tracker/pc"
  }
}
